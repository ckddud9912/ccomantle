# ============================================================
# ccomantle 환경변수 템플릿
# 사용법:  cp .env.example .env  →  값 채워넣기  →  docker compose up
# ============================================================

# 옵션 A: HF Hub에서 임베딩 자동 다운로드 (권장)
# 운영자가 본인 HF 계정에 임베딩을 dataset 으로 올려둔 경우 사용.
# 비워두면 다운로드 시도하지 않고, 로컬 data/ 폴더만 확인함.
EMBEDDING_HF_REPO=
EMBEDDING_HF_FILE=embedding_dictionary_e5.json
EMBEDDING_HF_TYPE=dataset

# 옵션 B: 임베딩 파일 경로 오버라이드
# 기본값 = /app/data/embedding_dictionary_e5.json. 보통 비워두면 됨.
EMBEDDING_FILE=
