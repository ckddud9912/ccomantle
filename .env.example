# ============================================================
# ccomantle 환경변수 템플릿
# 사용법:  cp .env.example .env  →  값 채워넣기  →  docker compose up
# ============================================================

# HF Hub에서 임베딩 자동 다운로드 (권장)
# 운영자가 본인 HF 계정에 임베딩을 dataset 으로 올려둔 경우 사용.
# 비워두거나 주석 처리하면 다운로드 시도 안 하고 로컬 data/ 만 확인.
EMBEDDING_HF_REPO=

# 거의 안 바꿈. 다른 파일명/타입 쓸 때만 활성화.
# EMBEDDING_HF_FILE=embedding_dictionary_e5.npz   # 옛 default 는 .json — 이제 .npz 명시
# EMBEDDING_HF_TYPE=dataset

# 임베딩 파일 경로 오버라이드 (특수한 경우만 사용)
# 기본값 = /app/data/embedding_dictionary_e5.npz
# EMBEDDING_FILE=
