# ============================================================
# ccomantle 환경변수 템플릿
# 사용법:  cp .env.example .env  →  값 채워넣기  →  docker compose up
# ============================================================

# HF Hub에서 임베딩 자동 다운로드 (권장)
# 프로젝트 공개 dataset 이 기본값으로 들어가 있어, cp 후 그대로 실행하면 자동 다운로드됨.
# 본인 HF 계정 사전을 쓰려면 값 교체. 비워두면 다운로드 안 하고 로컬 data/ 만 확인.
EMBEDDING_HF_REPO=leo4study/ccomantle-embeddings

# 거의 안 바꿈. 다른 파일명/타입 쓸 때만 활성화.
# EMBEDDING_HF_FILE=embedding_dictionary_e5.npz   # default 가 .npz — 옛 .json 쓸 때만 활성화
# EMBEDDING_HF_TYPE=dataset

# 임베딩 파일 경로 오버라이드 (특수한 경우만 사용)
# 기본값 = /app/data/embedding_dictionary_e5.npz
# EMBEDDING_FILE=
